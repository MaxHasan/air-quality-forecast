# Air Quality Predictor — environment template.
# Copy to `.env.local` (Next.js dev + local script runs) and fill in real values.
# `.env*` is gitignored except this file. NEVER commit real values.
#
#   cp .env.example .env.local
#
# Where each variable is consumed:
#   scripts/**            -> WAQI_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY   (GitHub Actions secrets)
#   src/app/**, src/lib/db.ts (browser + RSC) -> NEXT_PUBLIC_*                     (Vercel env vars)

# --- Ingestion / server-only (GitHub Actions secrets) -------------------------

# WAQI (aqicn.org) free API token. Request at https://aqicn.org/data-platform/token/
# Personal, non-commercial use only. Used by scripts/ingest/aq.ts.
WAQI_TOKEN=

# Supabase project REST URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase service-role key. FULL DATABASE ACCESS, BYPASSES RLS.
# Server/CI only — must never be exposed to the browser or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend / public (Vercel env vars) --------------------------------------

# Same value as SUPABASE_URL. Duplicated because only NEXT_PUBLIC_* is inlined
# into the client bundle by Next.js.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to ship to the browser: it is constrained
# by the row-level security policies in supabase/migrations/0003_rls.sql
# (SELECT-only on display tables, no access to push_subscriptions).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Local development toggles ------------------------------------------------

# Serve the fixtures in src/lib/mock-data.ts instead of reading Supabase, so the
# UI can be built and reviewed with no database, no credentials and no network.
# Accepts 1 / true / yes / on. Unset (the default) reads the real database.
# Leave this OUT of Vercel and CI — it would ship a dashboard of invented numbers.
# USE_MOCK_DATA=1
